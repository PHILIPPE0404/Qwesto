# Exemple local uniquement — ne jamais committer de vrais secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_PASSWORD=CHANGE-ME-TO-A-SECRET-OF-AT-LEAST-20-CHARACTERS
SESSION_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-OF-AT-LEAST-64-CHARACTERS

# CPX Research - use the App ID and Secure Hash shown in the approved Publisher dashboard.
# Keep the Secure Hash private: set it only in Render Environment, never in frontend files or GitHub.
CPX_ENABLED=false
CPX_APP_ID=
CPX_SECURE_HASH=
